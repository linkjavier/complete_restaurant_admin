# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blondie

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=1d

# NextAuth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (optional)
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Payment Gateway (optional)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Electronic billing (Sandbox only)
BILLING_ENV=sandbox
# Generate 32 random bytes and encode them as base64; do not commit the value.
BILLING_CREDENTIALS_ENCRYPTION_KEY=
FACTUS_SANDBOX_TEST_TENANT_ID=
FACTUS_SANDBOX_TEST_LOCATION_ID=
FACTUS_SANDBOX_TEST_PAYLOAD_FILE=
FACTUS_SANDBOX_TEST_IDEMPOTENCY_KEY=