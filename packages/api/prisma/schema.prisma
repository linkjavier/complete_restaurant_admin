// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  locations            Location[]
  products             Product[]
  orders               Order[]
  categories           Category[]
  ingredients          Ingredient[]
  customers            Customer[]
  tables               Table[]
  payments             Payment[]
  productVariantGroups ProductVariantGroup[]
  productVariants      ProductVariant[]
  settings             Settings[]
  subscriptions        Subscription[]
}

model User {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  email         String
  password      String
  firstName     String
  lastName      String
  role          UserRole
  avatar        String?
  location      Location?      @relation(fields: [locationId], references: [id])
  locationId    String?
  orders        Order[]        @relation("orderUser")
  deletedOrders Order[]        @relation("orderDeletedBy")
  notifications Notification[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([tenantId, email])
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
  CHEF
  CASHIER
  WAITER
  SUPER_ADMIN
}

model Location {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  name             String
  address          String
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  phone            String
  orders           Order[]
  users            User[]
  products         Product[]
  tables           Table[]
  whatsappMessages WhatsappMessage[]
  whatsappChats    WhatsappChat[]
  inventoryItems   InventoryItem[]
  ingredients      Ingredient[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  order            Int               @default(0)
  customers        Customer[]
  settings         Settings[]

  @@index([order])
  @@map("locations")
}

model Table {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  number     Int
  seats      Int
  status     TableStatus @default(AVAILABLE)
  qrCode     String?     @unique
  location   Location    @relation(fields: [locationId], references: [id])
  locationId String
  orders     Order[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Product {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  name          String
  description   String?
  price         Float
  image         String?
  category      Category              @relation(fields: [categoryId], references: [id])
  categoryId    String
  isActive      Boolean               @default(true)
  isFinal       Boolean               @default(false)
  quantity      Float                 @default(0)
  location      Location              @relation(fields: [locationId], references: [id])
  locationId    String
  ingredients   ProductIngredient[]
  orderItems    OrderItem[]
  productions   ProductionLog[]
  variants      ProductVariant[]
  variantGroups ProductVariantGroup[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  products    Product[]
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([order])
}

model Ingredient {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  quantity    Float
  unit        String
  minQuantity Float
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String
  products    ProductIngredient[]
  inventory   InventoryItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, name])
  @@index([locationId])
}

model ProductIngredient {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  quantity     Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
}

model InventoryItem {
  id           String     @id @default(cuid())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId String
  location     Location   @relation(fields: [locationId], references: [id])
  locationId   String
  quantity     Float
  minQuantity  Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ingredientId, locationId])
}

enum OrderType {
  TABLE
  TAKEOUT
  DELIVERY
}

enum OrderSource {
  POS
  QR
  WHATSAPP
}

model Order {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  location        Location?      @relation(fields: [locationId], references: [id])
  locationId      String?
  table           Table?         @relation(fields: [tableId], references: [id])
  tableId         String?
  type            OrderType      @default(TABLE)
  status          OrderStatus    @default(PENDING)
  isPaid          Boolean        @default(false)
  user            User?          @relation("orderUser", fields: [userId], references: [id])
  userId          String?
  customerName    String?
  deliveryAddress String?
  neighborhood    String?
  phone           String?
  paymentMethod   PaymentMethod?
  source          OrderSource
  items           OrderItem[]
  payments        Payment[]
  deliveryFee     Float?
  subtotal        Float?
  total           Float?
  isDeleted       Boolean?       @default(false)
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?          @relation("orderDeletedBy", fields: [deletedById], references: [id])
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String             @id @default(cuid())
  order     Order              @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product            @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  price     Float?
  status    OrderItemStatus    @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  variants  OrderItemVariant[]
}

model OrderItemVariant {
  id               String         @id @default(cuid())
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id])
  orderItemId      String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  groupName        String?
}

enum OrderItemStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model Payment {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  order     Order         @relation(fields: [orderId], references: [id])
  orderId   String
  amount    Float
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  QR
  TRANSFER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum NotificationType {
  ORDER_READY
  PAYMENT_RECEIVED
  TABLE_READY
  LOW_STOCK
  SYSTEM
  WAITER_CALL
}

model ProductionLog {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Float
  createdAt DateTime @default(now())
}

model WhatsappMessage {
  id          String   @id @default(cuid())
  from        String
  body        String
  timestamp   DateTime
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  isFromAI    Boolean  @default(false)
  isVoiceNote Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
  @@index([from])
  @@index([timestamp])
}

model WhatsappChat {
  id         String   @id @unique // The chat ID from WhatsApp (e.g., 'xxxxxxxxxxx@c.us')
  aiEnabled  Boolean  @default(true)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([locationId])
}

model Settings {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  aiName       String   @default("Sandra")
  aiGender     String   @default("female")
  aiEnabled    Boolean  @default(false)
  businessName String   @default("Kutchen AI")
  businessLogo String?
  deliveryFee  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, locationId])
  @@index([tenantId])
  @@index([locationId])
}

model ProductVariantGroup {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  name      String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  variants  ProductVariant[]
  order     Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model ProductVariant {
  id                String              @id @default(cuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  name              String
  price             Float?
  image             String?
  isActive          Boolean             @default(true)
  group             ProductVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId           String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  orderItemVariants OrderItemVariant[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([groupId])
  @@index([productId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone     String?
  location  Location @relation(fields: [locationId], references: [id])
  locationId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  address      String?
  neighborhood String?  
}

// Nuevos modelos para suscripciones y pagos
model Subscription {
  id                String              @id @default(uuid())
  tenantId          String
  tenant            Tenant              @relation(fields: [tenantId], references: [id])
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  stripeCustomerId  String?             // ID del cliente en Stripe
  stripeSubscriptionId String?          // ID de la suscripción en Stripe
  planName          String              // Nombre del plan (Starter, Professional, Enterprise)
  planPrice         Decimal             @db.Decimal(10, 2)
  status            SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd Boolean             @default(false)
  payments          SubscriptionPayment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model SubscriptionPayment {
  id              String              @id @default(uuid())
  subscriptionId  String
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id])
  stripePaymentId String              // ID del pago en Stripe
  amount          Decimal             @db.Decimal(10, 2)
  currency        String              @default("USD")
  status          PaymentStatus       @default(PENDING)
  paymentMethod   String?             // Método de pago usado
  metadata        Json?               // Datos adicionales del pago
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIAL
}
