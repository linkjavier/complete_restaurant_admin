DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blondie?schema=public"
JWT_SECRET="your-jwt-secret-key"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/auth/facebook/callback"
FRONTEND_URL="http://localhost:3001"

# Cloudflare R2 (required for uploading GLB/USDZ product models)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Public custom domain or enabled R2.dev URL for the bucket; no trailing slash.
# Do not use the *.r2.cloudflarestorage.com S3 API endpoint here.
# Enable public access on the bucket and configure CORS to allow GET/HEAD
# from every public menu frontend origin (e.g. http://localhost:3001).
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Meta WhatsApp Cloud API (webhook verification and integration-token encryption)
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=
# Generate 32 random bytes and encode them as base64; do not commit the value.
WHATSAPP_CLOUD_TOKEN_ENCRYPTION_KEY=
WHATSAPP_CLOUD_GRAPH_API_VERSION=v27.0

# Electronic billing (Sandbox only; Factus credentials are entered per location in Settings)
BILLING_ENV=sandbox
# Generate 32 random bytes and encode them as base64; do not commit the value.
BILLING_CREDENTIALS_ENCRYPTION_KEY=
FACTUS_SANDBOX_TEST_TENANT_ID=
FACTUS_SANDBOX_TEST_LOCATION_ID=
FACTUS_SANDBOX_TEST_PAYLOAD_FILE=
FACTUS_SANDBOX_TEST_IDEMPOTENCY_KEY=