{
  "name": "kutchen-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run dev:services",
    "dev": "turbo run dev --filter=@blondie/api --filter=@kutchen/web",
    "dev:services": "docker compose up -d --wait postgres redis",
    "dev:stop": "docker compose stop postgres redis",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "prisma": "^6.10.1",
    "turbo": "^1.13.4"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "engine.io-client": "^6.6.3",
    "openai": "^5.5.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.2"
  }
}
